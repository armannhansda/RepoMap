{
  "name": "repomap",
  "displayName": "RepoMap",
  "description": "Google Maps for Source Code inside VS Code",
  "version": "0.1.0",
  "publisher": "arman",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repomap.start",
        "title": "RepoMap: Start"
      }
    ],
    "configuration": {
      "title": "RepoMap",
      "properties": {
        "repomap.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for Google Gemini (Optional for AI Features)"
        },
        "repomap.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for Groq Llama 3 (Fallback Optional)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "esbuild": "^0.21.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5"
  }
}
